# Copy to .env and change every value before deploying anywhere real:
#   cp .env.example .env
# docker compose reads .env automatically. Generate strong values with:
#   openssl rand -hex 32

# Signs and verifies user JWTs. Shared by auth-service (signs) and api-gateway (verifies).
SECRET_KEY=change-me

# Shared by api-gateway and expense/category/analytics services. Proves a request came
# through the gateway; without it the services reject every call.
INTERNAL_API_KEY=change-me-too

# Postgres password for the bhavana user (used by all three databases).
POSTGRES_PASSWORD=change-me-three
